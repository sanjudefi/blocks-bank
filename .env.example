# PostgreSQL — set one of the following:
DATABASE_URL="postgresql://user:password@host:5432/blocks_bank?sslmode=require"
# POSTGRES_URL=""         # Vercel Postgres (auto-injected by Vercel)
# PRISMA_DATABASE_URL=""  # Vercel Postgres (auto-injected by Vercel)

# Auth
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Admin panel password
ADMIN_PASS="your-admin-password-here"

# Alchemy (blockchain RPC + API)
ALCHEMY_API_KEY="your-alchemy-api-key"
ALCHEMY_API_ID="your-alchemy-app-id"
NEXT_PUBLIC_ALCHEMY_API_KEY="your-alchemy-api-key"   # exposed to browser for wagmi RPC

# Vercel Blob (logo uploads)
BLOB_READ_WRITE_TOKEN="your-vercel-blob-token"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
